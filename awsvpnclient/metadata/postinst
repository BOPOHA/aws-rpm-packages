#!/bin/bash
# Post-install: set permissions and start daemon
set -e
INSTALL_BASE="/opt/awsvpnclient"
DAEMON="aws-client-vpn-daemon"

# Set binary permissions
chmod 750 "${INSTALL_BASE}/aws-client-vpn-daemon"
chmod 755 "${INSTALL_BASE}/aws-vpn-client"
# Posture agent: daemon spawns it as the user; must be executable or spawn hits EACCES.
chmod 755 "${INSTALL_BASE}/aws-vpn-client-agent"

# DNS scripts executable by root only
if [ -d "${INSTALL_BASE}/dns" ]; then
    find "${INSTALL_BASE}/dns" -type f -exec chmod 750 {} \;
fi

mkdir -p /var/lib/awsvpnclient
chmod 700 /var/lib/awsvpnclient

# Reload systemd and enable + start daemon
systemctl daemon-reload
systemctl enable "$DAEMON"
systemctl start "$DAEMON"

exit 0
